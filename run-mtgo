#!/bin/sh

# Install a desktop launcher, with the MTGO favicon, on first run.
desktop="$HOME/.local/share/applications/mtgo.desktop"
icon="$HOME/.local/share/mtgo/mtgo.ico"
if [ ! -f "$desktop" ]; then
    mkdir -p "$(dirname "$icon")" "$(dirname "$desktop")"
    [ -s "$icon" ] || wget -qO "$icon" https://www.mtgo.com/favicon.ico || echo "Warning: could not download MTGO icon" >&2
    cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Magic: The Gathering Online
Exec=$(readlink -f "$0")
Icon=$icon
Terminal=false
Categories=Game;CardGame;
StartupWMClass=mtgo.exe
EOF
fi

# Check if run-mtgo exists in /bin
if [ ! -f /bin/run-mtgo ]; then
    echo "Downloading run-mtgo..."
    wget -O /tmp/run-mtgo-script https://raw.githubusercontent.com/pauleve/docker-mtgo/master/run-mtgo
    chmod +x /tmp/run-mtgo-script
    sudo mv /tmp/run-mtgo-script /bin/run-mtgo
fi

# Check if the user is in the `docker` group. If not, add the user and prompt restart.
if [ $(id -Gn | grep -c docker) -eq 0 ]; then
    # Check if docker group exists, create it if it doesn't
    if ! getent group docker > /dev/null 2>&1; then
        echo "Docker group does not exist. Creating docker group..."
        sudo groupadd docker
    fi

    echo "Adding user to docker group..."
    sudo usermod -aG docker "$USER"
    echo "Please restart your computer to apply changes."
    exit 0
fi

# Run run-mtgo
/bin/run-mtgo "$@"
