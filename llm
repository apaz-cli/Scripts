# read_key() — read one keypress; prints a key name to stdout
read_key() {
    local key seq1 seq2
    IFS= read -rsn1 key || true
    if [[ "$key" == $'\033' ]]; then
        IFS= read -rsn1 -t 0.1 seq1 || true
        IFS= read -rsn1 -t 0.1 seq2 || true
        case "${seq1}${seq2}" in
            '[A') printf 'up' ;;
            '[B') printf 'down' ;;
            '[C') printf 'right' ;;
            '[D') printf 'left' ;;
            *)    printf 'esc' ;;
        esac
    elif [[ "$key" == '' || "$key" == $'\r' ]]; then
        printf 'enter'
    else
        printf '%s' "$key"
    fi
}


# handle_new_chat() — create a new chat and enter it
handle_new_chat() {
    local chat_id
    chat_id=$(create_chat "New Chat")
    chat_loop "$chat_id"
}

# handle_resume_chat() — list existing chats and pick one
handle_resume_chat() {
    clear_screen
    draw_header "Resume Chat"
    echo ""

    local chat_list
    chat_list=$(list_chats)

    if [[ -z "$chat_list" ]]; then
        echo "  No chats found."
        echo ""
        printf "  Press Enter to go back..."
        read -r
        return 0
    fi

    # Parse into arrays
    local -a ids titles counts thinkings
    local line idx=1
    while IFS='|' read -r id title count thinking; do
        ids+=("$id")
        titles+=("$title")
        counts+=("$count")
        thinkings+=("$thinking")
        local think_label
        if [[ "$thinking" == "max" ]]; then
            think_label="MAX"
        elif [[ "$thinking" == "true" ]]; then
            think_label="HIGH"
        else
            think_label="OFF"
        fi
        printf "  ${C_BOLD}%d${C_RESET}. %s  [%s msgs] [Thinking: %s]\n" \
            "$idx" "$title" "$count" "$think_label"
        ((idx++))
    done <<< "$chat_list"

    echo "  ${C_BOLD}0${C_RESET}. Back"
    echo ""
    printf "Select [0-%d]: " "$(( idx - 1 ))"
    read -r pick || { echo ""; return 0; }

    if [[ "$pick" =~ ^[0-9]+$ && "$pick" -ge 1 && "$pick" -lt "$idx" ]]; then
        chat_loop "${ids[$pick-1]}"
    fi
}

# -----------------------------------------------------------------------------
# agent_loop() — multi-turn tool execution loop (like nanocode agent_loop)
# Calls API, executes tools, feeds results back, repeats until no tool_calls.
# Stores intermediate messages in the chat file and returns 0 on success.
# -----------------------------------------------------------------------------
agent_loop() {
    local chat_id="$1"
    local file
    file="$(chat_filepath "$chat_id")"

    local max_turns=10
    local turn=0

    while [[ $turn -lt $max_turns ]]; do
        ((turn++))

        local messages_json thinking_enabled tools_json
        messages_json=$(jq '.messages' "$file")
        thinking_enabled=$(jq -r '.thinking // false' "$file")
        tools_json=$(get_active_tools_json "$chat_id")

        printf "${C_BOLD}${C_CYAN}[%s]${C_RESET}" "$default_model"
        [[ $turn -gt 1 ]] && printf " ${C_DIM}(turn %d)${C_RESET}" "$turn"
        printf "\n"

        local call_rc=0
        call_llm_stream "$messages_json" "$thinking_enabled" "$tools_json" || call_rc=$?

        if [[ $call_rc -ne 0 ]]; then
            echo ""
            return 1
        fi

        local result_json
        result_json="$_LLM_RESULT"

        local content thinking tool_calls_json
        content=$(echo "$result_json" | jq -rj '.content // ""'; printf x); content="${content%x}"
        thinking=$(echo "$result_json" | jq -rj '.thinking // ""'; printf x); thinking="${thinking%x}"
        tool_calls_json=$(echo "$result_json" | jq -rc '.tool_calls // empty' 2>/dev/null) || true

        # No tool calls — final response
        if [[ -z "$tool_calls_json" || "$tool_calls_json" == "[]" || "$tool_calls_json" == "null" ]]; then
            store_assistant_result "$chat_id" "$result_json"
            return 0
        fi

        # Store assistant message with tool_calls
        if [[ -n "$thinking" ]]; then
            append_message "$chat_id" "assistant" "$content" "$thinking" "$tool_calls_json"
        else
            append_message "$chat_id" "assistant" "$content" "" "$tool_calls_json"
        fi

        # Execute each tool call
        local tc_count i
        tc_count=$(echo "$tool_calls_json" | jq 'length')
        for (( i=0; i<tc_count; i++ )); do
            local tc_id tc_name tc_args tool_result result_summary
            tc_id=$(echo "$tool_calls_json" | jq -r ".[$i].id // empty")
            tc_name=$(echo "$tool_calls_json" | jq -r ".[$i].function.name // empty")
            tc_args=$(echo "$tool_calls_json" | jq -r ".[$i].function.arguments // empty")

            tool_result=$(execute_tool_call "$tc_name" "$tc_args" 2>&1)
            local result_lines
            result_lines=$(echo "$tool_result" | wc -l)
            if [[ $result_lines -le 1 ]]; then
                result_summary="$(echo "$tool_result" | head -c 80 | tr '\n' ' ')"
            else
                result_summary="${result_lines} lines, $(echo "$tool_result" | wc -c) chars"
            fi
            printf "  ${C_DIM}[tool:%s → %s]${C_RESET}\n" "$tc_name" "$result_summary"

            _append_tool_result_message "$chat_id" "$tc_id" "$tool_result"
        done

        # Redraw to show intermediate messages
        draw_chat "$chat_id"
    done

    color_echo "$C_YELLOW" "Agent loop reached max turns ($max_turns). Stopping."
    return 1
}

# chat_loop() — the main chat interaction loop
chat_loop() {
    local chat_id="$1"

    # Verify chat exists
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        printf "Press Enter to continue..."
        read -r
        return 1
    fi

    local input

    while true; do
        # Draw the full chat
        draw_chat "$chat_id"

        read -e -r -p $'\001\033[1m\002>\001\033[0m\002 ' input || exit 0

        # Empty input — redraw
        if [[ -z "$input" ]]; then
            continue
        fi

        history -s "$input"
        history -w

        # ——— Slash commands ———
        if [[ "$input" == /* ]]; then
            case "$input" in
                /help|/h)
                    echo ""
                    echo "  ${C_BOLD}Navigation${C_RESET}"
                    echo "  /new             - Start a new chat"
                    echo "  /resume          - Pick a previous chat"
                    echo "  /settings        - Open settings"
                    echo "  /quit, /exit, /q - Exit"
                    echo ""
                    echo "  ${C_BOLD}Chat${C_RESET}"
                    echo "  /compose, /c     - Open editor to compose a multiline message"
                    echo "  /thinking, /t    - Toggle thinking mode (OFF/HIGH)"
                    echo "  /max             - Toggle max thinking mode"
                    echo "  /showthinking    - Toggle display of thinking tokens"
                    echo "  /system          - Edit the system message"
                    echo "  /edit            - Edit last user message (or system prompt)"
                    echo "  /editresponse    - Edit last assistant response"
                    echo "  /retry           - Regenerate last assistant response"
                    echo "  /undo            - Remove last exchange (user + assistant)"
                    echo "  /rewind          - Truncate conversation to a chosen exchange"
                    echo "  /fork            - Branch conversation from a chosen exchange"
                    echo "  /delete          - Delete this chat"
                    echo ""
                    echo "  ${C_BOLD}Output${C_RESET}"
                    echo "  /export          - Export chat as plain text"
                    echo "  /copy            - Copy last assistant message to clipboard"
                    echo "  /clear           - Redraw the screen"
                    echo ""
                    echo "  ${C_BOLD}API${C_RESET}"
                    echo "  /apikey          - Set API key"
                    echo "  /apibase         - Set API base URL"
                    echo ""
                    echo "  ${C_BOLD}Tools${C_RESET}"
                    echo "  /tool            - List available tools (active ones marked *)"
                    echo "  /tool <name>     - Toggle a tool on/off for this chat"
                    echo "  /tool clear      - Disable all tools for this chat"
                    echo ""
                    echo "  /help, /h        - Show this help"
                    echo ""
                    printf "  Press Enter to continue..."
                    read -r
                    ;;
                /thinking|/t)
                    local current
                    current=$(jq -r '.thinking // false' "$file")
                    if [[ "$current" == "true" ]]; then
                        set_chat_thinking "$chat_id" "false"
                        echo ""
                        echo "  ${C_GREEN}Thinking: OFF${C_RESET}"
                    else
                        set_chat_thinking "$chat_id" "true"
                        echo ""
                        echo "  ${C_GREEN}Thinking: HIGH${C_RESET}"
                    fi
                    sleep 0.5
                    ;;
                /max)
                    local current
                    current=$(jq -r '.thinking // false' "$file")
                    if [[ "$current" == "max" ]]; then
                        set_chat_thinking "$chat_id" "false"
                        echo ""
                        echo "  ${C_GREEN}Thinking: OFF${C_RESET}"
                    else
                        set_chat_thinking "$chat_id" "max"
                        update_message "$chat_id" 0 "$_MAX_THINKING_SYSTEM_PROMPT"
                        echo ""
                        echo "  ${C_GREEN}Thinking: MAX${C_RESET}"
                    fi
                    sleep 0.5
                    ;;

                /compose|/c)
                    local compose_tmpfile compose_input
                    compose_tmpfile=$(mktemp --suffix=.txt)
                    ${EDITOR_CMD:-vi} "$compose_tmpfile" 2>/dev/null || {
                        rm -f "$compose_tmpfile"
                        continue
                    }
                    compose_input=$(< "$compose_tmpfile")
                    rm -f "$compose_tmpfile"
                    if [[ -z "$compose_input" ]]; then
                        continue
                    fi

                    local compose_count_before
                    compose_count_before=$(jq '.messages | length' "$file")
                    append_message "$chat_id" "user" "$compose_input"
                    if [[ "$compose_count_before" == "1" ]]; then
                        set_chat_title "$chat_id" "$(echo "$compose_input" | head -c 50)"
                    fi

                    draw_chat "$chat_id"

                    local compose_tools
                    compose_tools=$(get_active_tools_json "$chat_id")
                    if [[ -n "$compose_tools" && "$compose_tools" != "[]" ]]; then
                        agent_loop "$chat_id" || {
                            echo ""
                            color_echo "$C_RED" "Agent loop failed."
                            printf "  Press Enter to continue..."
                            read -r
                        }
                    else
                        printf "${C_BOLD}${C_CYAN}[%s]${C_RESET}\n" "$default_model"
                        local compose_messages compose_thinking compose_rc compose_result
                        compose_messages=$(jq '.messages' "$file")
                        compose_thinking=$(jq -r '.thinking // false' "$file")
                        compose_rc=0
                        call_llm_stream "$compose_messages" "$compose_thinking" "" || compose_rc=$?
                        compose_result="$_LLM_RESULT"

                        if [[ $compose_rc -ne 0 ]]; then
                            echo ""
                            color_echo "$C_RED" "API call failed. Check your API_KEY and network."
                            printf "  Press Enter to continue..."
                            read -r
                        elif [[ -n "$compose_result" ]]; then
                            store_assistant_result "$chat_id" "$compose_result"
                        fi
                    fi
                    echo ""
                    ;;
                /clear)
                    continue
                    ;;
                /export)
                    echo ""
                    draw_divider "━"
                    local chat_json exp_msg_count i role content thinking tool_calls_exp
                    chat_json=$(cat "$file")
                    exp_msg_count=$(echo "$chat_json" | jq '.messages | length')
                    for (( i=0; i<exp_msg_count; i++ )); do
                        role=$(echo "$chat_json" | jq -r ".messages[$i].role")
                        content=$(echo "$chat_json" | jq -r ".messages[$i].content // \"\"")
                        thinking=$(echo "$chat_json" | jq -r ".messages[$i].thinking // \"\"")
                        tool_calls_exp=$(echo "$chat_json" | jq -r ".messages[$i].tool_calls // empty" 2>/dev/null) || true
                        case "$role" in
                            system)
                                echo "[System]"
                                echo "$content"
                                ;;
                            user)
                                echo "[You]"
                                echo "$content"
                                ;;
                            assistant)
                                echo "[Assistant]"
                                if [[ -n "$thinking" ]]; then
                                    echo "[Thinking: $thinking]"
                                fi
                                if [[ -n "$tool_calls_exp" && "$tool_calls_exp" != "null" ]]; then
                                    local tc_names_exp
                                    tc_names_exp=$(echo "$tool_calls_exp" | jq -r '.[].function.name' 2>/dev/null)
                                    if [[ -n "$tc_names_exp" ]]; then
                                        while IFS= read -r tce; do
                                            echo "[Tool: $tce]"
                                        done <<< "$tc_names_exp"
                                    fi
                                fi
                                echo "$content"
                                ;;
                            tool)
                                echo "[Tool result]"
                                echo "$content"
                                ;;
                        esac
                        echo ""
                    done
                    draw_divider "━"
                    printf "Press Enter to continue..."
                    read -r
                    ;;
                /system)
                    local sys_content tmpfile new_sys
                    sys_content=$(jq -r '.messages[0].content // ""' "$file")
                    tmpfile=$(mktemp)
                    echo "$sys_content" > "$tmpfile"

                    echo ""
                    echo "  Opening editor to edit system message..."
                    ${EDITOR_CMD:-vi} "$tmpfile" 2>/dev/null || {
                        color_echo "$C_RED" "Editor failed"
                        rm -f "$tmpfile"
                        printf "  Press Enter to continue..."
                        read -r
                        continue
                    }

                    new_sys=$(cat "$tmpfile")
                    rm -f "$tmpfile"

                    if [[ -n "$new_sys" && "$new_sys" != "$sys_content" ]]; then
                        update_message "$chat_id" 0 "$new_sys"
                        echo "  ${C_GREEN}System message updated.${C_RESET}"
                        sleep 0.5
                    fi
                    ;;
                /retry)
                    msg_cnt=$(jq '.messages | length' "$file")
                    if [[ $msg_cnt -le 2 ]]; then
                        echo ""
                        echo "  ${C_YELLOW}Nothing to retry${C_RESET}"
                        sleep 0.5
                        continue
                    fi

                    # Get the last user message content
                    last_user_idx=$((msg_cnt - 2))
                    last_user_content=$(jq -r ".messages[$last_user_idx].content // \"\"" "$file")

                    # Remove last two messages (user + assistant)
                    remove_messages_after "$chat_id" "$last_user_idx"

                    # Re-append user message and re-send
                    echo ""
                    printf "${C_BOLD}${C_GREEN}[You]${C_RESET} %s\n" "$last_user_content"
                    printf "${C_BOLD}${C_CYAN}[%s]${C_RESET}\n" "$default_model"

                    append_message "$chat_id" "user" "$last_user_content"

                    local retry_tools
                    retry_tools=$(get_active_tools_json "$chat_id")
                    if [[ -n "$retry_tools" && "$retry_tools" != "[]" ]]; then
                        agent_loop "$chat_id" || true
                    else
                        messages_json=$(jq '.messages' "$file")
                        thinking_enabled=$(jq -r '.thinking // false' "$file")

                        call_llm_stream "$messages_json" "$thinking_enabled" "" || true
                        result_json="$_LLM_RESULT"

                        if [[ -n "$result_json" ]]; then
                            store_assistant_result "$chat_id" "$result_json"
                        fi
                    fi
                    echo ""
                    ;;
                /undo)
                    msg_cnt=$(jq '.messages | length' "$file")
                    if [[ $msg_cnt -le 2 ]]; then
                        echo ""
                        echo "  ${C_YELLOW}Nothing to undo${C_RESET}"
                        sleep 0.5
                        continue
                    fi

                    last_user_idx=$((msg_cnt - 2))
                    remove_messages_after "$chat_id" "$last_user_idx"
                    echo ""
                    echo "  ${C_GREEN}Last exchange removed.${C_RESET}"
                    sleep 0.5
                    ;;
                /rewind)
                    local msg_cnt; msg_cnt=$(jq '.messages | length' "$file")
                    local num_exchanges=$(( (msg_cnt - 1) / 2 ))
                    if [[ $num_exchanges -lt 1 ]]; then
                        echo ""; echo "  ${C_YELLOW}Nothing to rewind to${C_RESET}"; sleep 0.5; continue
                    fi
                    echo ""
                    for (( e=1; e<=num_exchanges; e++ )); do
                        local u_preview; u_preview=$(jq -r ".messages[$((2*e-1))].content" "$file" | head -c 60)
                        printf "  ${C_BOLD}%d${C_RESET}. %s\n" "$e" "$u_preview"
                    done
                    echo ""
                    printf "  Keep through exchange [1-%d] (Enter to cancel): " "$num_exchanges"
                    local rw_pick; read -r rw_pick
                    if [[ "$rw_pick" =~ ^[0-9]+$ && "$rw_pick" -ge 1 && "$rw_pick" -le "$num_exchanges" ]]; then
                        remove_messages_after "$chat_id" $(( 2 * rw_pick + 1 ))
                        echo "  ${C_GREEN}Rewound to exchange ${rw_pick}.${C_RESET}"; sleep 0.5
                    fi
                    ;;
                /fork)
                    local msg_cnt; msg_cnt=$(jq '.messages | length' "$file")
                    local num_exchanges=$(( (msg_cnt - 1) / 2 ))
                    if [[ $num_exchanges -lt 1 ]]; then
                        echo ""; echo "  ${C_YELLOW}Nothing to fork from${C_RESET}"; sleep 0.5; continue
                    fi
                    echo ""
                    for (( e=1; e<=num_exchanges; e++ )); do
                        local u_preview; u_preview=$(jq -r ".messages[$((2*e-1))].content" "$file" | head -c 60)
                        printf "  ${C_BOLD}%d${C_RESET}. %s\n" "$e" "$u_preview"
                    done
                    echo ""
                    printf "  Fork after exchange [1-%d] (Enter to cancel): " "$num_exchanges"
                    local fork_pick; read -r fork_pick
                    if [[ "$fork_pick" =~ ^[0-9]+$ && "$fork_pick" -ge 1 && "$fork_pick" -le "$num_exchanges" ]]; then
                        local fork_id; fork_id="$(date +%s%N 2>/dev/null || date +%s)$$"
                        local fork_file; fork_file="$(chat_filepath "$fork_id")"
                        jq --argjson end "$(( 2 * fork_pick + 1 ))" \
                            '.messages = .messages[:$end] | .title = "Fork: " + .title' \
                            "$file" > "$fork_file"
                        echo "  ${C_GREEN}Forked. Entering new chat.${C_RESET}"; sleep 0.5
                        chat_loop "$fork_id"
                    fi
                    ;;
                /copy)
                    msg_cnt=$(jq '.messages | length' "$file")
                    found=0
                    for (( copy_idx=msg_cnt-1; copy_idx>=0; copy_idx-- )); do
                        copy_role=$(jq -r ".messages[$copy_idx].role // \"\"" "$file")
                        if [[ "$copy_role" == "assistant" ]]; then
                            copy_content=$(jq -r ".messages[$copy_idx].content // \"\"" "$file")
                            found=1
                            break
                        fi
                    done
                    echo ""
                    if [[ $found -eq 0 || -z "$copy_content" ]]; then
                        echo "  ${C_YELLOW}Nothing to copy${C_RESET}"
                    else
                        if copy_to_clipboard "$copy_content"; then
                            echo "  ${C_GREEN}Copied to clipboard.${C_RESET}"
                        else
                            echo "  ${C_RED}Failed to copy to clipboard.${C_RESET}"
                        fi
                    fi
                    sleep 1
                    ;;
                /delete)
                    echo ""
                    printf "  ${C_RED}Delete this chat? (y/N):${C_RESET} "
                    read -r confirm
                    if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
                        delete_chat "$chat_id"
                        echo "  ${C_GREEN}Chat deleted.${C_RESET}"
                        sleep 0.5
                        return 0
                    else
                        echo "  ${C_YELLOW}Canceled.${C_RESET}"
                        sleep 0.5
                    fi
                    ;;
                /apikey)
                    echo ""
                    printf "  Enter API Key: "
                    read -s -r new_api_key
                    echo ""
                    if [[ -n "$new_api_key" ]]; then
                        API_KEY="$new_api_key"
                        save_config
                        echo "  ${C_GREEN}API Key updated.${C_RESET}"
                    else
                        echo "  ${C_YELLOW}API Key unchanged.${C_RESET}"
                    fi
                    sleep 1
                    ;;
                /apibase)
                    echo ""
                    printf "  Enter API Base URL [${API_BASE}]: "
                    read -r new_api_base
                    if [[ -n "$new_api_base" ]]; then
                        API_BASE="$new_api_base"
                        save_config
                        echo "  ${C_GREEN}API Base URL updated.${C_RESET}"
                    else
                        echo "  ${C_YELLOW}API Base URL unchanged.${C_RESET}"
                    fi
                    sleep 1
                    ;;
                /tool*)
                    echo ""
                    local tool_input
                    tool_input="${input#/tool}"
                    tool_input="${tool_input# }"
                    # /tool (no args) — list tools
                    if [[ -z "$tool_input" ]]; then
                        echo "  ${C_BOLD}Available tools:${C_RESET}"
                        local active_names
                        active_names=$(jq -r '.active_tools // [] | join(" ")' "$file" 2>/dev/null)
                        while IFS= read -r tname; do
                            local is_active=" "
                            for an in $active_names; do
                                [[ "$an" == "$tname" ]] && is_active="*"
                            done
                            local tdesc
                            tdesc=$(tool_description "$tname" 2>/dev/null)
                            printf "  ${C_BOLD}%s${C_RESET} %s\n" "${is_active}${tname}" "$tdesc"
                        done < <(list_tool_names)
                        echo ""
                        printf "  Press Enter to continue..."
                        read -r
                    elif [[ "$tool_input" == "clear" ]]; then
                        set_active_tools "$chat_id"
                        echo "  ${C_GREEN}All tools cleared.${C_RESET}"
                        sleep 0.5
                    else
                        # Toggle a specific tool
                        local tname="$tool_input"
                        local schema
                        schema=$(tool_schema "$tname" 2>/dev/null) || {
                            echo "  ${C_RED}Unknown tool: $tname${C_RESET}"
                            echo "  Use /tool to list available tools."
                            sleep 1
                            continue
                        }
                        local active_names
                        active_names=$(jq -r '.active_tools // []' "$file" 2>/dev/null)
                        local new_active=()
                        local found=0
                        for an in $(echo "$active_names" | jq -r '.[]' 2>/dev/null); do
                            if [[ "$an" == "$tname" ]]; then
                                found=1
                            else
                                new_active+=("$an")
                            fi
                        done
                        if [[ $found -eq 1 ]]; then
                            # Remove tool
                            set_active_tools "$chat_id" "${new_active[@]}"
                            echo "  ${C_GREEN}Removed tool: $tname${C_RESET}"
                        else
                            # Add tool
                            new_active+=("$tname")
                            set_active_tools "$chat_id" "${new_active[@]}"
                            echo "  ${C_GREEN}Added tool: $tname${C_RESET}"
                        fi
                        sleep 0.5
                    fi
                    ;;
                /quit|/exit|/q)
                    exit 0
                    ;;
                /showthinking)
                    if [[ "$show_thinking" == "true" ]]; then
                        show_thinking="false"
                        echo ""; echo "  ${C_GREEN}Thinking display: OFF${C_RESET}"
                    else
                        show_thinking="true"
                        echo ""; echo "  ${C_GREEN}Thinking display: ON${C_RESET}"
                    fi
                    sleep 0.5
                    ;;
                /edit)
                    local edit_idx edit_role tmpfile new_content old_content
                    local msg_cnt_e; msg_cnt_e=$(jq '.messages | length' "$file")
                    edit_idx=-1
                    for (( ei=msg_cnt_e-1; ei>=0; ei-- )); do
                        edit_role=$(jq -r ".messages[$ei].role" "$file")
                        if [[ "$edit_role" == "user" ]]; then
                            edit_idx=$ei; break
                        fi
                    done
                    if [[ $edit_idx -eq -1 ]]; then
                        edit_idx=0
                    fi
                    old_content=$(jq -r ".messages[$edit_idx].content // \"\"" "$file")
                    tmpfile=$(mktemp)
                    echo "$old_content" > "$tmpfile"
                    ${EDITOR_CMD:-vi} "$tmpfile" 2>/dev/null || { rm -f "$tmpfile"; continue; }
                    new_content=$(cat "$tmpfile"); rm -f "$tmpfile"
                    if [[ -n "$new_content" && "$new_content" != "$old_content" ]]; then
                        update_message "$chat_id" "$edit_idx" "$new_content"
                        echo "  ${C_GREEN}Message updated.${C_RESET}"; sleep 0.5
                    fi
                    ;;
                /editresponse)
                    local er_idx er_role er_tmpfile er_old_content er_old_thinking
                    local msg_cnt_r; msg_cnt_r=$(jq '.messages | length' "$file")
                    er_idx=-1
                    for (( ri=msg_cnt_r-1; ri>=0; ri-- )); do
                        er_role=$(jq -r ".messages[$ri].role" "$file")
                        if [[ "$er_role" == "assistant" ]]; then
                            er_idx=$ri; break
                        fi
                    done
                    if [[ $er_idx -eq -1 ]]; then
                        echo ""; echo "  ${C_YELLOW}No assistant message to edit${C_RESET}"; sleep 0.5; continue
                    fi
                    er_old_thinking=$(jq -r ".messages[$er_idx].thinking // \"\"" "$file")
                    er_old_content=$(jq -r ".messages[$er_idx].content // \"\"" "$file")
                    er_tmpfile=$(mktemp)
                    if [[ -n "$er_old_thinking" ]]; then
                        printf '%s\n---THINKING---\n%s' "$er_old_content" "$er_old_thinking" > "$er_tmpfile"
                    else
                        printf '%s' "$er_old_content" > "$er_tmpfile"
                    fi
                    ${EDITOR_CMD:-vi} "$er_tmpfile" 2>/dev/null || { rm -f "$er_tmpfile"; continue; }
                    local er_raw; er_raw=$(cat "$er_tmpfile"); rm -f "$er_tmpfile"
                    local er_new_content er_new_thinking
                    if [[ "$er_raw" == *$'\n---THINKING---\n'* ]]; then
                        er_new_content="${er_raw%%$'\n---THINKING---\n'*}"
                        er_new_thinking="${er_raw#*$'\n---THINKING---\n'}"
                    else
                        er_new_content="$er_raw"
                        er_new_thinking="$er_old_thinking"
                    fi
                    local er_tmp; er_tmp="$(chat_filepath "$chat_id").tmp.$$"
                    jq --argjson idx "$er_idx" \
                       --rawfile content <(printf '%s' "$er_new_content") \
                       --rawfile thinking <(printf '%s' "$er_new_thinking") \
                       '.messages[$idx].content = $content | .messages[$idx].thinking = $thinking' \
                       "$file" > "$er_tmp" && mv "$er_tmp" "$file"
                    echo "  ${C_GREEN}Response updated.${C_RESET}"; sleep 0.5
                    ;;
                /new)
                    local new_id
                    new_id=$(create_chat "New Chat")
                    chat_loop "$new_id"
                    ;;
                /resume)
                    handle_resume_chat
                    ;;
                /settings)
                    settings_loop
                    ;;
                *)
                    echo ""
                    echo "  ${C_RED}Unknown command: $input${C_RESET}  (type /help for help)"
                    sleep 1
                    ;;
            esac
            continue
        fi

        # ——— Regular message: send to LLM ———
        # Check if this is the first user message (for auto-title)
        local msg_count_before
        msg_count_before=$(jq '.messages | length' "$file")

        # Append user message
        append_message "$chat_id" "user" "$input"

        # Auto-title on first user message
        if [[ "$msg_count_before" == "1" ]]; then
            local auto_title
            auto_title=$(echo "$input" | head -c 50)
            set_chat_title "$chat_id" "$auto_title"
        fi

        # Redraw to show the new user message
        draw_chat "$chat_id"

        # Call the API (agent loop if tools active, otherwise simple call)
        local tools_json
        tools_json=$(get_active_tools_json "$chat_id")
        if [[ -n "$tools_json" && "$tools_json" != "[]" ]]; then
            agent_loop "$chat_id" || {
                echo ""
                color_echo "$C_RED" "Agent loop failed."
                printf "  Press Enter to continue..."
                read -r
            }
        else
            messages_json=$(jq '.messages' "$file")
            thinking_enabled=$(jq -r '.thinking // false' "$file")
            printf "${C_BOLD}${C_CYAN}[%s]${C_RESET}\n" "$default_model"

            call_rc=0
            call_llm_stream "$messages_json" "$thinking_enabled" "" || call_rc=$?
            result_json="$_LLM_RESULT"

            if [[ $call_rc -ne 0 ]]; then
                echo ""
                color_echo "$C_RED" "API call failed. Check your API_KEY and network."
                printf "  Press Enter to continue..."
                read -r
                echo ""
                continue
            fi

            # Append assistant response
            store_assistant_result "$chat_id" "$result_json"
        fi

        echo ""
    done
}

# settings_loop() — configure defaults
settings_loop() {
    local choice think_label model_choice new_key new_base custom_model
    while true; do
        clear_screen
        draw_header "Settings"
        echo ""
        if [[ "$default_thinking" == "max" ]]; then
            think_label="MAX"
        elif [[ "$default_thinking" == "true" ]]; then
            think_label="HIGH"
        else
            think_label="OFF"
        fi
        echo "  1. Default Thinking: ${C_BOLD}${think_label}${C_RESET}"
        echo "  2. Default Model: ${C_BOLD}${default_model}${C_RESET}"
        echo "  3. Set API Key"
        echo "  4. Set API Base URL"
        echo "  5. Back"
        echo ""
        printf "Select [1-5]: "
        read -r choice || { echo ""; break; }

        case "$choice" in
            1)
                if [[ "$default_thinking" == "false" ]]; then
                    default_thinking="true"
                elif [[ "$default_thinking" == "true" ]]; then
                    default_thinking="max"
                else
                    default_thinking="false"
                fi
                save_config
                ;;
            2)
                echo ""
                echo "  Available models:"
                echo "    ${C_BOLD}1${C_RESET}. deepseek-v4-pro"
                echo "    ${C_BOLD}2${C_RESET}. deepseek-reasoner"
                echo "    ${C_BOLD}3${C_RESET}. gpt-4o"
                echo "    ${C_BOLD}4${C_RESET}. gpt-4o-mini"
                echo "    ${C_BOLD}5${C_RESET}. Custom..."
                echo ""
                printf "  Select model [1-5]: "
                read -r model_choice
                case "$model_choice" in
                    1) default_model="deepseek-v4-pro" ;;
                    2) default_model="deepseek-reasoner" ;;
                    3) default_model="gpt-4o" ;;
                    4) default_model="gpt-4o-mini" ;;
                    5)
                        echo ""
                        printf "  Enter custom model name: "
                        read -r custom_model
                        if [[ -n "$custom_model" ]]; then
                            default_model="$custom_model"
                        fi
                        ;;
                    *) continue ;;
                esac
                save_config
                ;;
            3)
                echo ""
                echo "  Note: Set the LLM_DEEPSEEK_API_KEY env variable for persistence."
                printf "  Or enter API Key here (saved to config): "
                read -s -r new_key
                echo ""
                if [[ -n "$new_key" ]]; then
                    API_KEY="$new_key"
                    save_config
                    echo "  ${C_GREEN}API Key saved.${C_RESET}"
                fi
                sleep 0.5
                ;;
            4)
                echo ""
                printf "  Enter API Base URL [${API_BASE}]: "
                read -r new_base
                if [[ -n "$new_base" ]]; then
                    API_BASE="$new_base"
                    save_config
                    echo "  ${C_GREEN}API Base URL saved.${C_RESET}"
                fi
                sleep 0.5
                ;;
            5) return 0 ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# main() — TUI entry point
# -----------------------------------------------------------------------------
main() {
    # Handle CLI flags before entering TUI
    case "${1:-}" in
        -h|--help|help)
            echo "Usage: llm-tui.sh [OPTIONS]"
            echo ""
            echo "A terminal UI for interacting with LLM APIs."
            echo ""
            echo "Options:"
            echo "  -h, --help     Show this help message and exit"
            echo "  -v, --version  Show version information and exit"
            echo ""
            echo "Environment variables:"
            echo "  LLM_DEEPSEEK_API_KEY  API key for authentication (required)"
            echo "  API_BASE              API base URL (default: https://api.deepseek.com)"
            echo "  MODEL                 Default model (default: deepseek-v4-pro)"
            echo ""
            exit 0
            ;;
        -v|--version)
            echo "llm-tui.sh version 1.0.0"
            exit 0
            ;;
    esac

    check_dependencies
    mkdir -p "$CHAT_DIR" "$CONFIG_DIR"
    load_config
    if [[ -z "$API_KEY" ]]; then
        color_echo "$C_RED" "ERROR: LLM_DEEPSEEK_API_KEY is not set."
        color_echo "$C_YELLOW" "Export it in your shell profile, or run:"
        color_echo "$C_YELLOW" "  export LLM_DEEPSEEK_API_KEY=your-key-here"
        exit 1
    fi
    detect_editor || true
    find_clipboard_cmd || true

    HISTFILE="$CONFIG_DIR/input_history"
    history -r 2>/dev/null || true

    # Trap EXIT for a friendly goodbye
    trap 'echo ""; echo "Goodbye!"' EXIT
    trap 'TERM_WIDTH=$(tput cols 2>/dev/null || echo 80); _RESIZE_FLAG=true' SIGWINCH

    # Auto-start: resume most recent chat, or create a new one
    local chat_list first_id start_id
    chat_list=$(list_chats)
    if [[ -n "$chat_list" ]]; then
        first_id=$(echo "$chat_list" | head -1 | cut -d'|' -f1)
        chat_loop "$first_id"
    else
        start_id=$(create_chat "New Chat")
        chat_loop "$start_id"
    fi
}

# If executed directly (not sourced), run main
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
