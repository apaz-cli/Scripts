#!/usr/bin/env bash
# =============================================================================
# llm-tui.sh — A terminal UI for interacting with LLM APIs
# =============================================================================
set -euo pipefail

# Add local bin directories to PATH (for static jq etc.)
for local_bin in "$HOME/.local/bin" "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)/.local/bin"; do
    if [[ -d "$local_bin" ]]; then
        export PATH="$local_bin:$PATH"
    fi
done

# -----------------------------------------------------------------------------
# Configuration (hardcoded defaults)
# -----------------------------------------------------------------------------
_API_BASE_DEFAULT="https://api.deepseek.com"
API_KEY="${LLM_DEEPSEEK_API_KEY:-}"
API_BASE="${API_BASE:-$_API_BASE_DEFAULT}"
MODEL="${MODEL:-deepseek-v4-pro}"

# XDG base directories (fall back to ~/.local/share and ~/.config)
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

CHAT_DIR="${CHAT_DIR:-$XDG_DATA_HOME/llm-tui/chats}"
CONFIG_DIR="${CONFIG_DIR:-$XDG_CONFIG_HOME/llm-tui}"
CONFIG_FILE="${CONFIG_FILE:-$CONFIG_DIR/config}"

# Runtime globals
EDITOR_CMD=""
CLIP_CMD=""
default_thinking="true"
default_model="$MODEL"
_MAX_THINKING_SYSTEM_PROMPT='Reasoning Effort: Absolute maximum with no shortcuts permitted.
You MUST be very thorough in your thinking and comprehensively decompose the problem to resolve the root cause, rigorously stress-testing your logic against all potential paths, edge cases, and adversarial scenarios.
Explicitly write out your entire deliberation process, documenting every intermediate step, considered alternative, and rejected hypothesis to ensure absolutely no assumption is left unchecked.'
_LLM_RESULT=""
_RESIZE_FLAG=false
show_thinking="true"

# -----------------------------------------------------------------------------
# Tool Registry — define one _tool_<name> function per tool; auto-discovered
# -----------------------------------------------------------------------------
_tool_read_file() { jq -n --arg cwd "$PWD" '{type:"function",function:{name:"read_file",description:"Read a file from the local filesystem",parameters:{type:"object",properties:{filePath:{type:"string",description:("Absolute path to the file. cwd: " + $cwd)},offset:{type:"integer",description:"Line number to start from (1-indexed)"},limit:{type:"integer",description:"Max lines to read (default 2000)"}},required:["filePath"]}}}'; }
_tool_grep()     { jq -n '{type:"function",function:{name:"grep",description:"Search file contents by regex pattern",parameters:{type:"object",properties:{pattern:{type:"string",description:"Regex pattern to search for"},path:{type:"string",description:"Directory path to search in (defaults to current dir)"},include:{type:"string",description:"File pattern filter, e.g. \"*.sh\""}},required:["pattern"]}}}'; }
_tool_glob()     { jq -n '{type:"function",function:{name:"glob",description:"Find files matching a glob pattern",parameters:{type:"object",properties:{pattern:{type:"string",description:"Glob pattern, e.g. \"src/**/*.ts\""},path:{type:"string",description:"Directory to search in"}},required:["pattern"]}}}'; }

list_tool_names() {
    declare -F | grep -oP '\b_tool_\K(?!exec)\w+' | sort
}

tool_description() {
    local fn="_tool_${1}"
    declare -F "$fn" &>/dev/null || { echo "Unknown tool"; return 1; }
    "$fn" | jq -r '.function.description'
}

tool_schema() {
    local fn="_tool_${1}"
    declare -F "$fn" &>/dev/null || return 1
    "$fn"
}

build_active_tools_json() {
    local first=true
    printf '['
    for name in "$@"; do
        local schema
        schema=$(tool_schema "$name" 2>/dev/null) || continue
        [[ "$first" != true ]] && printf ','
        first=false
        printf '%s' "$schema"
    done
    printf ']'
}

# -----------------------------------------------------------------------------
# execute_tool_call() — dispatch to _tool_exec_<name>
# -----------------------------------------------------------------------------
execute_tool_call() {
    local name="$1"
    local fn="_tool_exec_${name}"
    declare -F "$fn" &>/dev/null || { echo "Error: Unknown tool: $name"; return; }
    "$fn" "$2"
}

# Tool exec functions — one _tool_exec_<name> per tool
_tool_exec_read_file() {
    local args_json="$1" fp offset limit
    fp=$(echo "$args_json" | jq -r '.filePath // empty')
    [[ -z "$fp" ]] && { echo "Error: filePath is required"; return; }
    fp="${fp/#\~\//$HOME/}"
    [[ "$fp" == "~" ]] && fp="$HOME"
    offset=$(echo "$args_json" | jq -r '.offset // 1')
    limit=$(echo "$args_json" | jq -r '.limit // 2000')
    if [[ -f "$fp" ]]; then
        tail -n +"$offset" "$fp" 2>/dev/null | head -n "$limit" || true
    else
        echo "Error: File not found: $fp"
    fi
}

_tool_exec_grep() {
    local args_json="$1" pattern gpath include
    pattern=$(echo "$args_json" | jq -r '.pattern // empty')
    [[ -z "$pattern" ]] && { echo "Error: pattern is required"; return; }
    gpath=$(echo "$args_json" | jq -r '.path // "."')
    gpath="${gpath/#\~\//$HOME/}"
    [[ "$gpath" == "~" ]] && gpath="$HOME"
    include=$(echo "$args_json" | jq -r '.include // "*"')
    grep -rn --include="$include" "$pattern" "$gpath" 2>&1 | head -50 || true
}

_tool_exec_glob() {
    local args_json="$1" gpattern gpath2
    gpattern=$(echo "$args_json" | jq -r '.pattern // empty')
    [[ -z "$gpattern" ]] && { echo "Error: pattern is required"; return; }
    gpath2=$(echo "$args_json" | jq -r '.path // "."')
    gpath2="${gpath2/#\~\//$HOME/}"
    [[ "$gpath2" == "~" ]] && gpath2="$HOME"
    find "$gpath2" -path "$gpath2/$gpattern" -type f 2>&1 | head -50 || true
}

# -----------------------------------------------------------------------------
# _append_tool_result_message() — append a tool result to the chat file
# -----------------------------------------------------------------------------
_append_tool_result_message() {
    local chat_id="$1"
    local tool_call_id="$2"
    local content="$3"
    local file tmp
    file="$(chat_filepath "$chat_id")"
    [[ ! -f "$file" ]] && { color_echo "$C_RED" "Chat not found: $chat_id"; return 1; }
    tmp="${file}.tmp.$$"
    jq --arg tool_call_id "$tool_call_id" \
        --rawfile content <(printf '%s' "$content") \
        '.messages += [{role: "tool", tool_call_id: $tool_call_id, content: $content}]' \
        "$file" > "$tmp" && mv "$tmp" "$file"
}

# -----------------------------------------------------------------------------
# ANSI color escape variables
# -----------------------------------------------------------------------------
C_RESET=$'\033[0m'
C_DIM=$'\033[2m'
C_BOLD=$'\033[1m'
C_RED=$'\033[31m'
C_GREEN=$'\033[32m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'
C_MAGENTA=$'\033[35m'
C_CYAN=$'\033[36m'
C_WHITE=$'\033[37m'
C_GRAY=$'\033[90m'

# -----------------------------------------------------------------------------
# Utility: print colorized message to stderr
# -----------------------------------------------------------------------------
color_echo() {
    local color="$1"
    local message="$2"
    echo -e "${color}${message}${C_RESET}" >&2
}

# -----------------------------------------------------------------------------
# check_dependencies() — verify required external programs exist
# -----------------------------------------------------------------------------
check_dependencies() {
    local missing=()
    for cmd in curl jq; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        color_echo "$C_RED" "ERROR: Missing required dependencies: ${missing[*]}"
        color_echo "$C_YELLOW" "Please install them and re-run."
        exit 1
    fi
}

# -----------------------------------------------------------------------------
# load_config() — read CONFIG_FILE if it exists (key=value format)
# Sets global variables: default_thinking, default_model, API_KEY, API_BASE
# -----------------------------------------------------------------------------
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        while IFS='=' read -r key value; do
            # Skip blank lines and comments
            [[ -z "$key" || "$key" == \#* ]] && continue
            case "$key" in
                default_thinking) default_thinking="$value" ;;
                default_model)    default_model="$value" ;;
                api_key)
                    if [[ -z "$API_KEY" ]]; then
                        API_KEY="$value"
                    fi
                    ;;
                api_base)
                    if [[ "$API_BASE" == "$_API_BASE_DEFAULT" ]]; then
                        API_BASE="$value"
                    fi
                    ;;
            esac
        done < "$CONFIG_FILE"
    fi
}

# -----------------------------------------------------------------------------
# save_config() — write configuration to CONFIG_FILE
# -----------------------------------------------------------------------------
save_config() {
    mkdir -p "$(dirname "$CONFIG_FILE")"
    cat > "$CONFIG_FILE" <<EOF
# llm-tui configuration
default_thinking=${default_thinking}
default_model=${default_model}
api_key=${API_KEY}
api_base=${API_BASE}
EOF
}

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
detect_editor() {
    if [[ -n "${EDITOR:-}" ]]; then
        EDITOR_CMD="$EDITOR"
    elif command -v xdg-open &>/dev/null; then
        EDITOR_CMD="xdg-open"
    else
        color_echo "$C_RED" "ERROR: No editor found. Set \$EDITOR."
        exit 1
    fi
}

# -----------------------------------------------------------------------------
# find_clipboard_cmd() — detect available clipboard program
# Sets global CLIP_CMD; empty string if none found
# -----------------------------------------------------------------------------
find_clipboard_cmd() {
    local candidates=(
        "wl-copy"
        "xclip -selection clipboard"
        "pbcopy"
        "clip.exe"
        "termux-clipboard-set"
    )
    for candidate in "${candidates[@]}"; do
        # Extract the base command (first word)
        local base_cmd="${candidate%% *}"
        if command -v "$base_cmd" &>/dev/null; then
            CLIP_CMD="$candidate"
            return 0
        fi
    done
    CLIP_CMD=""
    return 1
}

# -----------------------------------------------------------------------------
# copy_to_clipboard() — copy text to system clipboard
# Reads from stdin if no argument given, otherwise copies the first argument.
# Returns 0 on success, 1 on failure.
# -----------------------------------------------------------------------------
copy_to_clipboard() {
    local text
    if [[ $# -ge 1 ]]; then
        text="$1"
    else
        text="$(cat)"
    fi

    if [[ -z "$CLIP_CMD" ]]; then
        color_echo "$C_YELLOW" "No clipboard program available"
        return 1
    fi

    case "$CLIP_CMD" in
        wl-copy)
            echo -n "$text" | wl-copy 2>/dev/null && return 0 || return 1
            ;;
        "xclip -selection clipboard")
            echo -n "$text" | xclip -selection clipboard 2>/dev/null && return 0 || return 1
            ;;
        pbcopy)
            echo -n "$text" | pbcopy 2>/dev/null && return 0 || return 1
            ;;
        clip.exe)
            echo -n "$text" | clip.exe 2>/dev/null && return 0 || return 1
            ;;
        termux-clipboard-set)
            echo -n "$text" | termux-clipboard-set 2>/dev/null && return 0 || return 1
            ;;
        *)
            return 1
            ;;
    esac
}

# -----------------------------------------------------------------------------
# chat_filepath() — return the JSON file path for a given chat ID
# -----------------------------------------------------------------------------
chat_filepath() {
    local chat_id="$1"
    echo "${CHAT_DIR}/${chat_id}.json"
}

# -----------------------------------------------------------------------------
# list_chats() — list all .json chat files with details
# Output: one line per chat in format "ID|TITLE|COUNT|THINKING"
# -----------------------------------------------------------------------------
list_chats() {
    mkdir -p "$CHAT_DIR"
    local files=()
    if [[ -d "$CHAT_DIR" ]]; then
        # Collect .json files sorted by modification time (newest first)
        while IFS= read -r -d '' f; do
            files+=("$f")
        done < <(find "$CHAT_DIR" -maxdepth 1 -name '*.json' -type f -printf '%T@ %p\0' 2>/dev/null | sort -rn -z | cut -d' ' -f2- -z)
    fi

    if [[ ${#files[@]} -eq 0 ]]; then
        return 0
    fi

    for f in "${files[@]}"; do
        local chat_id
        chat_id="$(basename "$f" .json)"
        local title count thinking
        title="$(jq -r '.title // "Untitled"' "$f" 2>/dev/null || echo "Untitled")"
        count="$(jq -r '(.messages // []) | length' "$f" 2>/dev/null || echo "0")"
        thinking="$(jq -r '.thinking // false' "$f" 2>/dev/null || echo "false")"
        printf '%s|%s|%s|%s\n' "$chat_id" "$title" "$count" "$thinking"
    done
}

# -----------------------------------------------------------------------------
# create_chat() — create a new chat JSON file
# Parameters: optional title (defaults to "New Chat")
# Echoes the new chat_id to stdout
# -----------------------------------------------------------------------------
create_chat() {
    local title="${1:-New Chat}"
    mkdir -p "$CHAT_DIR"

    # Generate a unique ID using epoch seconds + nanoseconds + PID
    local chat_id
    chat_id="$(date +%s%N 2>/dev/null || date +%s)$$"

    local file
    file="$(chat_filepath "$chat_id")"

    # Initialize chat JSON with a default system message
    local default_system
    if [[ "$default_thinking" == "max" ]]; then
        default_system="$_MAX_THINKING_SYSTEM_PROMPT"
    else
        default_system="You are a helpful assistant."
    fi
    jq -n \
        --arg title "$title" \
        --arg thinking "$default_thinking" \
        --arg system_msg "$default_system" \
        '{
            title: $title,
            thinking: (if $thinking == "max" then "max" elif $thinking == "true" then true else false end),
            messages: [
                {role: "system", content: $system_msg}
            ]
        }' > "$file"

    echo "$chat_id"
}

# -----------------------------------------------------------------------------
# read_chat() — output the full JSON of a chat file
# Returns 0 on success, 1 if file not found
# -----------------------------------------------------------------------------
read_chat() {
    local chat_id="$1"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi
    cat "$file"
}

# -----------------------------------------------------------------------------
# write_chat() — overwrite a chat file with new JSON (pretty-printed)
# Parameters: chat_id, json_string
# -----------------------------------------------------------------------------
write_chat() {
    local chat_id="$1"
    local json_str="$2"
    local file
    file="$(chat_filepath "$chat_id")"
    local tmp="${file}.tmp.$$"
    echo "$json_str" | jq '.' > "$tmp" && mv "$tmp" "$file"
}

# -----------------------------------------------------------------------------
# delete_chat() — remove a chat file by ID
# -----------------------------------------------------------------------------
delete_chat() {
    local chat_id="$1"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ -f "$file" ]]; then
        rm -f "$file"
    fi
}

# -----------------------------------------------------------------------------
# get_message() — extract a single message by index (0-based)
# Parameters: chat_id, index
# Outputs the message JSON object
# -----------------------------------------------------------------------------
get_message() {
    local chat_id="$1"
    local index="$2"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi
    jq --argjson idx "$index" '.messages[$idx]' "$file"
}

# -----------------------------------------------------------------------------
# update_message() — update the content of a message at a given index
# Parameters: chat_id, index, new_content
# -----------------------------------------------------------------------------
update_message() {
    local chat_id="$1"
    local index="$2"
    local new_content="$3"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi
    local tmp="${file}.tmp.$$"
    jq --argjson idx "$index" \
        --rawfile content <(printf '%s' "$new_content") \
        '.messages[$idx].content = $content' \
        "$file" > "$tmp" && mv "$tmp" "$file"
}

# -----------------------------------------------------------------------------
# append_message() — append a message to the messages array
# Parameters: chat_id, role, content [, thinking [, tool_calls_json]]
# -----------------------------------------------------------------------------
append_message() {
    local chat_id="$1"
    local role="$2"
    local content="$3"
    local thinking="${4:-}"
    local tool_calls="${5:-}"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi
    local tmp="${file}.tmp.$$"

    if [[ -n "$tool_calls" && "$tool_calls" != "[]" && "$tool_calls" != "null" ]]; then
        if [[ -n "$thinking" ]]; then
            jq --arg role "$role" \
                --rawfile content <(printf '%s' "$content") \
                --rawfile thinking <(printf '%s' "$thinking") \
                --argjson tool_calls "$tool_calls" \
                '.messages += [{role: $role, content: $content, thinking: $thinking, tool_calls: $tool_calls}]' \
                "$file" > "$tmp" && mv "$tmp" "$file"
        else
            jq --arg role "$role" \
                --rawfile content <(printf '%s' "$content") \
                --argjson tool_calls "$tool_calls" \
                '.messages += [{role: $role, content: $content, tool_calls: $tool_calls}]' \
                "$file" > "$tmp" && mv "$tmp" "$file"
        fi
    elif [[ -n "$thinking" ]]; then
        jq --arg role "$role" \
            --rawfile content <(printf '%s' "$content") \
            --rawfile thinking <(printf '%s' "$thinking") \
            '.messages += [{role: $role, content: $content, thinking: $thinking}]' \
            "$file" > "$tmp" && mv "$tmp" "$file"
    else
        jq --arg role "$role" \
            --rawfile content <(printf '%s' "$content") \
            '.messages += [{role: $role, content: $content}]' \
            "$file" > "$tmp" && mv "$tmp" "$file"
    fi
}

# -----------------------------------------------------------------------------
# get_active_tools_json() — read active tool names from chat and build JSON array
# -----------------------------------------------------------------------------
get_active_tools_json() {
    local chat_id="$1"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        echo "[]"
        return
    fi
    local names
    names=$(jq -r '.active_tools // [] | join(" ")' "$file" 2>/dev/null)
    if [[ -z "$names" ]]; then
        echo "[]"
        return
    fi
    # shellcheck disable=SC2086
    build_active_tools_json $names
}

# -----------------------------------------------------------------------------
# store_assistant_result() — parse _LLM_RESULT and append assistant message
# Parameters: chat_id, result_json
# -----------------------------------------------------------------------------
store_assistant_result() {
    local chat_id="$1"
    local result_json="$2"
    local thinking content tool_calls
    thinking=$(echo "$result_json" | jq -rj '.thinking // ""'; printf x); thinking="${thinking%x}"
    content=$(echo "$result_json" | jq -rj '.content // ""'; printf x); content="${content%x}"
    tool_calls=$(echo "$result_json" | jq -rc '.tool_calls // empty' 2>/dev/null) || true

    if [[ -n "$tool_calls" && "$tool_calls" != "[]" && "$tool_calls" != "null" ]]; then
        append_message "$chat_id" "assistant" "$content" "$thinking" "$tool_calls"
    elif [[ -n "$thinking" ]]; then
        append_message "$chat_id" "assistant" "$content" "$thinking"
    else
        append_message "$chat_id" "assistant" "$content"
    fi
}

# -----------------------------------------------------------------------------
# set_active_tools() — replace the .active_tools array on a chat
# Parameters: chat_id, tool_names (space-separated)
# -----------------------------------------------------------------------------
set_active_tools() {
    local chat_id="$1"
    shift
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi
    local tmp="${file}.tmp.$$"
    if [[ $# -eq 0 ]]; then
        jq 'del(.active_tools)' "$file" > "$tmp" && mv "$tmp" "$file"
    else
        local args_json
        args_json=$(printf '%s\n' "$@" | jq -R . | jq -s .)
        jq --argjson names "$args_json" '.active_tools = $names' "$file" > "$tmp" && mv "$tmp" "$file"
    fi
}

# -----------------------------------------------------------------------------
# remove_messages_after() — truncate messages array before a given index
# Keeps messages with indices < $index (i.e., removes index and beyond)
# Parameters: chat_id, index
# -----------------------------------------------------------------------------
remove_messages_after() {
    local chat_id="$1"
    local index="$2"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi
    local tmp="${file}.tmp.$$"
    jq --argjson idx "$index" 'del(.messages[range($idx; (.messages | length))])' \
        "$file" > "$tmp" && mv "$tmp" "$file"
}

# -----------------------------------------------------------------------------
# set_chat_thinking() — set the .thinking field on a chat
# Parameters: chat_id, bool ("true" or "false")
# -----------------------------------------------------------------------------
set_chat_thinking() {
    local chat_id="$1"
    local value="$2"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi
    local tmp="${file}.tmp.$$"
    local json_val
    if [[ "$value" == "max" ]]; then
        json_val='"max"'
    elif [[ "$value" == "true" || "$value" == "1" ]]; then
        json_val='true'
    else
        json_val='false'
    fi
    jq --argjson val "$json_val" '.thinking = $val' \
        "$file" > "$tmp" && mv "$tmp" "$file"
}

# -----------------------------------------------------------------------------
# set_chat_title() — set the .title field on a chat
# Parameters: chat_id, title
# -----------------------------------------------------------------------------
set_chat_title() {
    local chat_id="$1"
    local title="$2"
    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi
    local tmp="${file}.tmp.$$"
    jq --arg title "$title" '.title = $title' \
        "$file" > "$tmp" && mv "$tmp" "$file"
}

# -----------------------------------------------------------------------------
# build_request_body() — build the JSON request body for the API
# Parameters: messages_json (JSON array string), thinking_enabled ("true"/"false")
#             [, tools_json (JSON array of tool schemas, empty/"[]" = none)]
# Outputs the request body JSON to stdout
# -----------------------------------------------------------------------------
build_request_body() {
    local messages_json="$1"
    local thinking_enabled="$2"
    local tools_json="${3:-}"

    # Strip extra fields (like .thinking) from messages, keeping role, content, tool_calls, tool_call_id
    local clean_messages
    clean_messages=$(echo "$messages_json" | jq '[.[] | {role, content} + (if .tool_calls then {tool_calls} else {} end) + (if .tool_call_id then {tool_call_id} else {} end) | if .content == "" and .tool_calls then del(.content) else . end]')

    if [[ "$thinking_enabled" == "true" || "$thinking_enabled" == "max" ]]; then
        if [[ -n "$tools_json" && "$tools_json" != "[]" ]]; then
            printf '%s' "$clean_messages" | jq -n \
                --arg model "$default_model" \
                --argjson tools "$tools_json" \
                '{
                    model: $model,
                    messages: input,
                    stream: true,
                    thinking: {type: "enabled"},
                    reasoning_effort: "high",
                    tools: $tools
                }'
        else
            printf '%s' "$clean_messages" | jq -n \
                --arg model "$default_model" \
                '{
                    model: $model,
                    messages: input,
                    stream: true,
                    thinking: {type: "enabled"},
                    reasoning_effort: "high"
                }'
        fi
    else
        if [[ -n "$tools_json" && "$tools_json" != "[]" ]]; then
            printf '%s' "$clean_messages" | jq -n \
                --arg model "$default_model" \
                --argjson tools "$tools_json" \
                '{
                    model: $model,
                    messages: input,
                    stream: true,
                    thinking: {type: "disabled"},
                    tools: $tools
                }'
        else
            printf '%s' "$clean_messages" | jq -n \
                --arg model "$default_model" \
                '{
                    model: $model,
                    messages: input,
                    stream: true,
                    thinking: {type: "disabled"}
                }'
        fi
    fi
}

# -----------------------------------------------------------------------------
# call_llm_stream() — call the LLM API with streaming via SSE
# Parameters: messages_json (JSON array string), thinking_enabled ("true"/"false")
#             [, tools_json (JSON array of tool schemas) ]
# Outputs accumulated result as JSON via _LLM_RESULT:
#   {"thinking": "...", "content": "...", "tool_calls": [...]}
# Also prints streaming tokens to stdout in real-time
# -----------------------------------------------------------------------------
call_llm_stream() {
    local messages_json="$1"
    local thinking_enabled="$2"
    local tools_json="${3:-}"

    if [[ -z "$API_KEY" ]]; then
        printf "${C_RED}ERROR: API_KEY is not set.${C_RESET}\n"
        return 1
    fi

    local request_body
    request_body=$(build_request_body "$messages_json" "$thinking_enabled" "$tools_json")

    local full_thinking="" full_content="" first_line="" line data
    local thinking content api_err
    local transitioned=false
    local curl_err
    curl_err=$(mktemp)

    # Tool call accumulation
    local -A _tc_id=() _tc_name=() _tc_args=()
    local -a _tc_indices=()

    while IFS= read -r line; do
        [[ -z "$first_line" && -n "$line" ]] && first_line="$line"

        [[ "$line" =~ ^data:\ (.*) ]] || continue
        data="${BASH_REMATCH[1]}"
        [[ "$data" == "[DONE]" ]] && continue

        api_err=$(jq -r '.error.message // empty' <<< "$data" 2>/dev/null) || true
        if [[ -n "$api_err" ]]; then
            printf "\n${C_RED}API error: %s${C_RESET}\n" "$api_err"
            rm -f "$curl_err"
            return 1
        fi

        thinking=$(jq -rj '.choices[0].delta.reasoning_content // empty' <<< "$data" 2>/dev/null; printf x) || true
        thinking="${thinking%x}"
        content=$(jq -rj '.choices[0].delta.content // empty' <<< "$data" 2>/dev/null; printf x) || true
        content="${content%x}"

        if [[ -n "$thinking" ]]; then
            [[ "$show_thinking" == "true" ]] && printf "${C_GRAY}%s${C_RESET}" "$thinking"
            full_thinking+="$thinking"
        fi
        if [[ -n "$content" ]]; then
            if [[ "$transitioned" == false && -n "$full_thinking" && "$show_thinking" == "true" ]]; then
                printf "\n"
                transitioned=true
            fi
            printf "%s" "$content"
            full_content+="$content"
        fi

        # Handle tool_calls delta
        local tc_count
        tc_count=$(jq '.choices[0].delta.tool_calls | length // 0' <<< "$data" 2>/dev/null) || tc_count=0
        if [[ "$tc_count" -gt 0 ]]; then
            local i=0
            while [[ $i -lt $tc_count ]]; do
                local tc_idx
                tc_idx=$(jq -r ".choices[0].delta.tool_calls[$i].index // empty" <<< "$data" 2>/dev/null) || true
                [[ -z "$tc_idx" ]] && { ((i++)); continue; }

                local tc_func_name tc_func_args tc_call_id
                tc_func_name=$(jq -r ".choices[0].delta.tool_calls[$i].function.name // empty" <<< "$data" 2>/dev/null) || true
                tc_func_args=$(jq -r ".choices[0].delta.tool_calls[$i].function.arguments // empty" <<< "$data" 2>/dev/null) || true
                tc_call_id=$(jq -r ".choices[0].delta.tool_calls[$i].id // empty" <<< "$data" 2>/dev/null) || true

                [[ -n "$tc_call_id" ]] && _tc_id["$tc_idx"]="$tc_call_id"
                [[ -n "$tc_func_name" ]] && _tc_name["$tc_idx"]="$tc_func_name"
                [[ -n "$tc_func_args" ]] && _tc_args["$tc_idx"]+="$tc_func_args"

                # Track index order
                local found=0
                for idx in "${_tc_indices[@]}"; do
                    [[ "$idx" == "$tc_idx" ]] && { found=1; break; }
                done
                [[ $found -eq 0 ]] && _tc_indices+=("$tc_idx")

                ((i++))
            done
        fi
    done < <(curl -s -N --connect-timeout 10 --max-time 120 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $API_KEY" \
        -d "$request_body" \
        "${API_BASE}/chat/completions" 2>"$curl_err")

    # Build tool_calls JSON array from accumulated data
    local tool_calls_json="[]"
    if [[ ${#_tc_indices[@]} -gt 0 ]]; then
        # Display tool calls to user
        if [[ "$transitioned" == false && -n "$full_thinking" && "$show_thinking" == "true" ]]; then
            printf "\n"
            transitioned=true
        fi
        local first_tc=true
        tool_calls_json="["
        for idx in "${_tc_indices[@]}"; do
            [[ "$first_tc" != true ]] && tool_calls_json+=","
            first_tc=false
            printf "${C_YELLOW}[tool:%s]${C_RESET}" "${_tc_name[$idx]}"
            local tc_id="${_tc_id[$idx]}"
            [[ -z "$tc_id" ]] && tc_id="call_${idx}_$(date +%s%N)"
            tool_calls_json+=$(jq -n \
                --arg id "$tc_id" \
                --arg name "${_tc_name[$idx]}" \
                --arg args "${_tc_args[$idx]}" \
                '{id: $id, type: "function", function: {name: $name, arguments: $args}}')
        done
        tool_calls_json+="]"
        printf "\n"
    fi

    if [[ -z "$full_content" && -z "$full_thinking" && ${#_tc_indices[@]} -eq 0 ]]; then
        if [[ -n "$first_line" ]]; then
            api_err=$(jq -r '.error.message // empty' <<< "$first_line" 2>/dev/null) || true
            if [[ -n "$api_err" ]]; then
                printf "\n${C_RED}API error: %s${C_RESET}\n" "$api_err"
            else
                printf "\n${C_RED}Empty response from API.${C_RESET}\n"
                printf "${C_DIM}Raw: %s${C_RESET}\n" "$first_line"
            fi
        else
            printf "\n${C_RED}No response received.${C_RESET}\n"
            printf "${C_DIM}  request size: %d bytes${C_RESET}\n" "${#request_body}"
            if [[ -s "$curl_err" ]]; then
                printf "${C_DIM}  curl: %s${C_RESET}\n" "$(head -c 200 "$curl_err")"
            fi
        fi
        rm -f "$curl_err"
        return 1
    fi

    rm -f "$curl_err"
    printf "\n"

    _LLM_RESULT=$(jq -n \
        --rawfile thinking <(printf '%s' "$full_thinking") \
        --rawfile content <(printf '%s' "$full_content") \
        --argjson tool_calls "$tool_calls_json" \
        '{thinking: $thinking, content: $content, tool_calls: $tool_calls}')
}

# -----------------------------------------------------------------------------
# call_llm() — non-streaming (fallback) call to the LLM API
# Parameters: messages_json (JSON array string), thinking_enabled ("true"/"false")
#             [, tools_json (JSON array of tool schemas) ]
# Outputs result as JSON: {"thinking": "...", "content": "...", "tool_calls": [...]}
# -----------------------------------------------------------------------------
call_llm() {
    local messages_json="$1"
    local thinking_enabled="$2"
    local tools_json="${3:-}"

    if [[ -z "$API_KEY" ]]; then
        color_echo "$C_RED" "ERROR: API_KEY is not set."
        return 1
    fi

    # Build request body WITHOUT streaming
    local request_body
    local clean_messages
    clean_messages=$(echo "$messages_json" | jq '[.[] | {role, content} + (if .tool_calls then {tool_calls} else {} end) + (if .tool_call_id then {tool_call_id} else {} end) | if .content == "" and .tool_calls then del(.content) else . end]')

    if [[ -n "$tools_json" && "$tools_json" != "[]" ]]; then
        if [[ "$thinking_enabled" == "true" || "$thinking_enabled" == "max" ]]; then
            request_body=$(printf '%s' "$clean_messages" | jq -n \
                --arg model "$default_model" \
                --argjson tools "$tools_json" \
                '{
                    model: $model,
                    messages: input,
                    stream: false,
                    thinking: {type: "enabled"},
                    reasoning_effort: "high",
                    tools: $tools
                }')
        else
            request_body=$(printf '%s' "$clean_messages" | jq -n \
                --arg model "$default_model" \
                --argjson tools "$tools_json" \
                '{
                    model: $model,
                    messages: input,
                    stream: false,
                    tools: $tools
                }')
        fi
    else
        if [[ "$thinking_enabled" == "true" || "$thinking_enabled" == "max" ]]; then
            request_body=$(printf '%s' "$clean_messages" | jq -n \
                --arg model "$default_model" \
                '{
                    model: $model,
                    messages: input,
                    stream: false,
                    thinking: {type: "enabled"},
                    reasoning_effort: "high"
                }')
        else
            request_body=$(printf '%s' "$clean_messages" | jq -n \
                --arg model "$default_model" \
                '{
                    model: $model,
                    messages: input,
                    stream: false
                }')
        fi
    fi

    color_echo "$C_DIM" "Calling API (non-streaming): POST ${API_BASE}/chat/completions"

    local response curl_err
    curl_err=$(mktemp)
    response=$(curl -s "$API_BASE/chat/completions" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $API_KEY" \
        -d "$request_body" 2>"$curl_err")

    # Check for API error
    local err_msg
    err_msg=$(echo "$response" | jq -r '.error.message // empty' 2>/dev/null)
    if [[ -n "$err_msg" ]]; then
        color_echo "$C_RED" "API error: $err_msg"
        rm -f "$curl_err"
        return 1
    elif [[ -z "$response" ]]; then
        color_echo "$C_RED" "No response received."
        if [[ -s "$curl_err" ]]; then
            color_echo "$C_DIM" "curl: $(head -c 200 "$curl_err")"
        fi
        rm -f "$curl_err"
        return 1
    fi
    rm -f "$curl_err"

    local thinking content tool_calls
    thinking=$(echo "$response" | jq -r '.choices[0].message.reasoning_content // empty' 2>/dev/null)
    content=$(echo "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null)
    tool_calls=$(echo "$response" | jq -r '.choices[0].message.tool_calls // empty' 2>/dev/null) || true

    if [[ -n "$thinking" ]]; then
        printf "${C_GRAY}%s${C_RESET}\n" "$thinking" >&2
    fi
    if [[ -n "$content" ]]; then
        printf "%s\n" "$content" >&2
    fi
    if [[ -n "$tool_calls" && "$tool_calls" != "null" ]]; then
        printf "${C_YELLOW}[tool_calls] %s${C_RESET}\n" "$(echo "$tool_calls" | jq -r '.[].function.name')" >&2
    fi

    jq -n \
        --rawfile thinking <(printf '%s' "$thinking") \
        --rawfile content <(printf '%s' "$content") \
        --argjson tool_calls "${tool_calls:-[]}" \
        '{thinking: $thinking, content: $content, tool_calls: $tool_calls}'
}

# -----------------------------------------------------------------------------
# send_message() — high-level: send user message and get assistant response
# Parameters: chat_id, user_content
# Updates the chat file with user message + assistant response (with thinking)
# -----------------------------------------------------------------------------
send_message() {
    local chat_id="$1"
    local user_content="$2"

    local file
    file="$(chat_filepath "$chat_id")"
    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi

    # Check if this is the first user message (before appending)
    local msg_count_before
    msg_count_before=$(jq '.messages | length' "$file" 2>/dev/null || echo "0")
    local is_first_user="false"
    if [[ "$msg_count_before" == "1" ]]; then
        is_first_user="true"
    fi

    # Append the user message
    append_message "$chat_id" "user" "$user_content"

    # Get current messages and tools setting
    local tools_json
    tools_json=$(get_active_tools_json "$chat_id")

    # Agent loop if tools active, otherwise simple call
    if [[ -n "$tools_json" && "$tools_json" != "[]" ]]; then
        agent_loop "$chat_id" || {
            color_echo "$C_RED" "Agent loop failed"
            return 1
        }
    else
        local messages_json thinking_enabled
        messages_json=$(jq '.messages' "$file")
        thinking_enabled=$(jq -r '.thinking // false' "$file")

        # Call the streaming API
        local result_json call_rc
        call_rc=0
        call_llm_stream "$messages_json" "$thinking_enabled" "" || call_rc=$?
        result_json="$_LLM_RESULT"

        if [[ $call_rc -ne 0 ]]; then
            color_echo "$C_RED" "API call failed"
            return 1
        fi

        # Parse the result and check for empty content + no tool calls
        local assistant_content
        assistant_content=$(echo "$result_json" | jq -rj '.content // ""'; printf x)
        assistant_content="${assistant_content%x}"
        local tool_calls
        tool_calls=$(echo "$result_json" | jq -rc '.tool_calls // empty' 2>/dev/null) || true

        if [[ -z "$assistant_content" && ( -z "$tool_calls" || "$tool_calls" == "[]" || "$tool_calls" == "null" ) ]]; then
            local assistant_thinking
            assistant_thinking=$(echo "$result_json" | jq -rj '.thinking // ""'; printf x)
            assistant_thinking="${assistant_thinking%x}"
            if [[ -z "$assistant_thinking" ]]; then
                color_echo "$C_RED" "ERROR: Empty response from API"
                return 1
            fi
        fi

        # Append the assistant response
        store_assistant_result "$chat_id" "$result_json"
    fi

    # Auto-set title from first user message
    if [[ "$is_first_user" == "true" ]]; then
        local auto_title
        auto_title=$(echo "$user_content" | head -c 50)
        set_chat_title "$chat_id" "$auto_title"
        color_echo "$C_DIM" "Set chat title: $auto_title"
    fi

    return 0
}

# -----------------------------------------------------------------------------
# TUI RENDERING FUNCTIONS
# -----------------------------------------------------------------------------

# Terminal width (cached once; can be overridden via env)
TERM_WIDTH="${TERM_WIDTH:-$(tput cols 2>/dev/null || echo 80)}"

# clear_screen() — clear the terminal
clear_screen() {
    tput clear 2>/dev/null || printf '\033[2J\033[H'
}

# draw_divider() — draw a horizontal rule across the terminal
draw_divider() {
    local char="${1:--}"
    local line
    printf -v line '%*s' "$TERM_WIDTH" ''
    printf '%s\n' "${line// /$char}"
}

# draw_header() — print a centered title bar with box-drawing characters
draw_header() {
    local title="$1"
    local inner_width=$((TERM_WIDTH - 2))

    # Build the full title text with padding
    local full_title=" LLM TUI - ${title} "

    # Truncate if too long (leave room for ellipsis)
    if [[ ${#full_title} -gt $inner_width ]]; then
        local max_title_len=$((inner_width - 4))  # " LLM TUI - " + "... "
        if [[ $max_title_len -lt 1 ]]; then
            max_title_len=1
        fi
        full_title=" LLM TUI - ${title:0:$max_title_len}... "
        # Final safety: if still too long, brute-force truncate
        if [[ ${#full_title} -gt $inner_width ]]; then
            full_title="${full_title:0:$inner_width}"
        fi
    fi

    local title_len=${#full_title}
    local left_pad=$(( (inner_width - title_len) / 2 ))
    local right_pad=$(( inner_width - title_len - left_pad ))

    local border_line
    printf -v border_line '%*s' "$inner_width" ''
    border_line="${border_line// /═}"

    printf "╔%s╗\n" "$border_line"
    printf "║%*s%s%*s║\n" "$left_pad" '' "$full_title" "$right_pad" ''
    printf "╚%s╝\n" "$border_line"
}

# format_message_content() — print multiline content with continuation indent
# Args: content, indent_spaces
format_message_content() {
    local content="$1"
    local indent="${2:-0}"
    local first=1
    while IFS= read -r line; do
        if [[ $first -eq 1 ]]; then
            printf "%s\n" "$line"
            first=0
        else
            printf "%*s%s\n" "$indent" "" "$line"
        fi
    done <<< "$content"
}

# draw_message() — format a single message (1-indexed for display)
draw_message() {
    local index="$1"   # 1-indexed display index (0 for system)
    local role="$2"
    local content="$3"
    local thinking="${4:-}"
    local tool_calls="${5:-}"

    case "$role" in
        system)
            printf "${C_YELLOW}[System]${C_RESET}\n"
            printf "%s\n" "$content"
            ;;
        user)
            printf "${C_BOLD}${C_GREEN}[%d] You${C_RESET}\n" "$index"
            printf "%s\n" "$content"
            ;;
        assistant)
            printf "${C_BOLD}${C_CYAN}[%d] %s${C_RESET}\n" "$index" "$default_model"
            if [[ -n "$thinking" && "$show_thinking" == "true" ]]; then
                printf "${C_GRAY}%s${C_RESET}\n" "$thinking"
            fi
            if [[ -n "$tool_calls" && "$tool_calls" != "null" ]]; then
                local tc_names
                tc_names=$(echo "$tool_calls" | jq -r '.[].function.name' 2>/dev/null)
                if [[ -n "$tc_names" ]]; then
                    while IFS= read -r tc_n; do
                        printf "${C_YELLOW}  [tool:%s]${C_RESET}\n" "$tc_n"
                    done <<< "$tc_names"
                fi
            fi
            printf "%s\n" "$content"
            ;;
        tool)
            printf "${C_DIM}[tool]${C_RESET}\n"
            local tool_result_preview
            tool_result_preview=$(echo "$content" | head -c 200)
            printf "${C_DIM}%s${C_RESET}\n" "$tool_result_preview"
            ;;
        *)
            printf "[%d] %s\n" "$index" "$role"
            printf "%s\n" "$content"
            ;;
    esac
}

# draw_chat() — clear screen and render the full chat
draw_chat() {
    local chat_id="$1"
    local file
    file="$(chat_filepath "$chat_id")"

    if [[ ! -f "$file" ]]; then
        color_echo "$C_RED" "Chat not found: $chat_id"
        return 1
    fi

    local chat_json
    chat_json=$(cat "$file")

    local title thinking model active_tools
    title=$(echo "$chat_json" | jq -r '.title // "Untitled"')
    thinking=$(echo "$chat_json" | jq -r '.thinking // false')
    model="$default_model"
    active_tools=$(echo "$chat_json" | jq -r '.active_tools // [] | join(",")' 2>/dev/null)

    clear_screen

    local thinking_label
    if [[ "$thinking" == "max" ]]; then
        thinking_label="MAX"
    elif [[ "$thinking" == "true" ]]; then
        thinking_label="HIGH"
    else
        thinking_label="OFF"
    fi
    local tools_str=""
    if [[ -n "$active_tools" ]]; then
        tools_str="  [Tools: ${active_tools}]"
    fi
    draw_header "Chat: ${title}  [Thinking: ${thinking_label}]  [Model: ${model}]${tools_str}"

    # Messages
    local msg_count
    msg_count=$(echo "$chat_json" | jq '.messages | length')
    local user_idx=0
    local i
    for (( i=0; i<msg_count; i++ )); do
        local role content msg_thinking msg_tool_calls
        role=$(echo "$chat_json" | jq -r ".messages[$i].role // empty")
        content=$(echo "$chat_json" | jq -r ".messages[$i].content // \"\"")
        msg_thinking=$(echo "$chat_json" | jq -r ".messages[$i].thinking // \"\"")
        msg_tool_calls=$(echo "$chat_json" | jq -r ".messages[$i].tool_calls // empty" 2>/dev/null) || true

        case "$role" in
            system)
                draw_message 0 "$role" "$content" ""
                ;;
            user)
                (( ++user_idx ))
                draw_message "$user_idx" "$role" "$content" ""
                ;;
            assistant)
                draw_message "$user_idx" "$role" "$content" "$msg_thinking" "$msg_tool_calls"
                ;;
            tool)
                draw_message "$user_idx" "$role" "$content" ""
                ;;
        esac
    done

    # Divider at bottom
    draw_divider "─"
}

